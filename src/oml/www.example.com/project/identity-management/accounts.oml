    instance Account11 : account:Account [
        base:itemName "Cedar Build Agent - AWS"
        account:nativeIdentity "cedar-build-agent"
        account:isCorrelated true
        account:correlatesTo identities:Identity6
        account:holdsEntitlement entitlements:Entitlement9
    ]

    instance Account12 : account:Account [
        base:itemName "Avery Morgan - AWS"
        account:nativeIdentity "amorgan-cloud"
        account:isCorrelated true
        account:correlatesTo identities:Identity1
        account:holdsEntitlement entitlements:Entitlement9, entitlements:Entitlement10
